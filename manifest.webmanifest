{
  "name": "AV Studios: Texture Pack Editor",
  "short_name": "Texture Editor",
  "description": "Pixel editor for texture packs by AV Studios and ItsAnshuXD.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#03100f",
  "theme_color": "#03100f",
  "categories": [
    "graphics",
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "application/zip": [
          ".zip",
          ".jar",
          ".mcpack",
          ".mcaddon"
        ]
      }
    }
  ]
}